# Copy to backend/.env and fill in. backend/.env is ignored by git.

# Real LLM planner (OpenAI-compatible Chat Completions API).
# The planner is enabled only when both LLM_API_KEY and LLM_MODEL are set.
# There is no default model: use the exact identifier your provider documents.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Optional. Sent as "reasoning_effort" only when set (for example low, medium, high).
LLM_REASONING_EFFORT=
LLM_TIMEOUT_S=120

# Simulator speed multiplier for durations and timeouts. 1.0 is demo speed; 0.5 is twice as fast.
SIM_TIME_SCALE=1.0

# Fleet definition: robot types and robots. Relative to backend/.
FLEET_FILE=config/fleet.json

# SQLite file. Delete it to start from a clean state.
DATABASE_PATH=data/orchestrator.db
